{
  "name": "@vitrea-spike/s2-geometry-field",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Gating spike S2 — pseudo-SDF field error vs ground-truth continuous-corner contour distance, plus WGSL shader cost. Standalone; no vitrea package dependencies.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "report": "tsx src/report.ts",
    "fit": "tsx src/fit-cli.ts",
    "bench": "tsx bench/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
