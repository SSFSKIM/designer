{
  "name": "vitrea-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Dual-artifact monorepo: the designer Claude Code plugin (skills/) and the vitrea Liquid Glass material runtime (packages/, apps/).",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && eslint .",
    "test": "pnpm -r test",
    "ci": "pnpm -r build && pnpm -r lint && pnpm -r test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
