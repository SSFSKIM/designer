{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // The site reads `scenes.json` (the geometry contract both renderers read) and
    // `matrix.json` (the calibration results) directly, so that no number and no
    // rectangle on the page is a second hand-kept copy of one.
    "resolveJsonModule": true,
    // Mirrors `vite.config.ts`'s aliases, so the typecheck reads the same source
    // the dev server bundles. Resolving to `dist` instead would typecheck the
    // playground against a build that may not exist yet.
    "paths": {
      "@vitreajs/vitrea": ["../../packages/core/src/index.ts"],
      "@vitrea/geometry": ["../../packages/geometry/src/index.ts"],
      "@vitrea/motion": ["../../packages/motion/src/index.ts"],
      "@vitreajs/vitrea-web": ["../../packages/platform-web/src/index.ts"],
      "@vitreajs/vitrea-react": ["../../packages/react/src/index.ts"],
    }
  },
  "include": ["src", "vite.config.ts", "../reference-apple/scenes.json", "../../packages/calibration/results/matrix.json"]
}
