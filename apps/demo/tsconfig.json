{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // Mirrors `vite.config.ts`'s aliases, so the typecheck reads the same source
    // the dev server bundles. Resolving to `dist` instead would typecheck the
    // playground against a build that may not exist yet.
    "paths": {
      "@vitrea/core": ["../../packages/core/src/index.ts"],
      "@vitrea/geometry": ["../../packages/geometry/src/index.ts"],
      "@vitrea/motion": ["../../packages/motion/src/index.ts"],
      "@vitrea/platform-web": ["../../packages/platform-web/src/index.ts"],
      "@vitrea/react": ["../../packages/react/src/index.ts"],
    }
  },
  "include": ["src", "vite.config.ts"]
}
