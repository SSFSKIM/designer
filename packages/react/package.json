{
  "name": "@vitreajs/vitrea-react",
  "version": "0.9.0",
  "description": "React bindings for vitrea: GlassRoot, GlassGroup, GlassSurface and the v1 controls.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/SSFSKIM/designer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SSFSKIM/designer.git",
    "directory": "packages/react"
  },
  "keywords": [
    "liquid-glass",
    "react",
    "webgpu",
    "material",
    "glass"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . && tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitreajs/vitrea": "workspace:^",
    "@vitreajs/vitrea-web": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitrea/geometry": "workspace:*",
    "@vitrea/motion": "workspace:*",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
