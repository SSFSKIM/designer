{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W41 committed renderer-bound exposure manifest",
  "description": "Generated by runner.freeze, committed before runner.run_production. The files map holds SHA-256 hashes over verified committed payload bytes, never hash-only promises. See README for scorer and pixel payload contracts. Production membership is declared glass intersected with the fixed committed archive inventory. runtimeArtifacts separately binds executed policy build modules to committed byte snapshots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "revision",
    "boundarySha256",
    "runnerSha256",
    "scenes",
    "split",
    "generation",
    "numericalCells",
    "renderedCells",
    "sourceFiles",
    "files",
    "candidates",
    "config",
    "scorer",
    "declaration",
    "closure",
    "instruments",
    "inventory",
    "excludedCells",
    "runtimeArtifacts"
  ],
  "properties": {
    "schema": {
      "const": "w41-renderer-exposure-1"
    },
    "mode": {
      "enum": [
        "production",
        "synthetic"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "boundarySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runnerSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenes": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "split": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "numericalCells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^/]+/[^/]+$"
      }
    },
    "renderedCells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^/]+/[^/]+$"
      }
    },
    "sourceFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parameters",
          "predictions",
          "rendered",
          "survival"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "parameters": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "predictions": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "rendered": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "survival": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        }
      }
    },
    "config": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "scorer": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "declaration": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "closure": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "instruments": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "inventory": {
      "type": [
        "string",
        "null"
      ],
      "description": "Fixed committed inventory metadata path in production; null for a synthetic subset."
    },
    "excludedCells": {
      "type": "object",
      "required": [
        "numerical",
        "rendered"
      ],
      "additionalProperties": false,
      "properties": {
        "numerical": {
          "type": "object",
          "additionalProperties": {
            "const": "not admitted by fixed archive inventory"
          }
        },
        "rendered": {
          "type": "object",
          "additionalProperties": {
            "const": "not admitted by fixed archive inventory"
          }
        }
      },
      "description": "Declared scope minus admitted scope, with a reason for each excluded cell. Does not change the split. Empty maps in synthetic mode."
    },
    "runtimeArtifacts": {
      "$ref": "#/$defs/runtimeArtifacts"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "production"
          }
        }
      },
      "then": {
        "properties": {
          "generation": {
            "const": [
              "58329732f947d42cd5e1518962016191faaa79d89b7089c6dadf5724dde35f61"
            ]
          },
          "inventory": {
            "const": "packages/calibration/results/2026-09-26-w39-g1-colour-edge-sitting/archive/inventory.json"
          },
          "runtimeArtifacts": {
            "minProperties": 1,
            "required": [
              "packages/policy/dist/index.js"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "inventory": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parameters",
        "predictions",
        "rendered",
        "survival"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "parameters": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "predictions": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "rendered": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "survival": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    },
    "numericalPredictions": {
      "type": "object",
      "required": [
        "cells"
      ],
      "additionalProperties": false,
      "properties": {
        "cells": {
          "type": "object",
          "minProperties": 1,
          "description": "Exact declared AND archive-admitted glass membership of numericalCells; finite, nonempty forward-output JSON per cell. No native observations."
        }
      }
    },
    "renderedPredictions": {
      "type": "object",
      "required": [
        "cells"
      ],
      "additionalProperties": false,
      "properties": {
        "cells": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "png",
              "projection"
            ],
            "additionalProperties": false,
            "properties": {
              "png": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "projection": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              }
            }
          }
        }
      }
    },
    "survival": {
      "type": "object",
      "required": [
        "numerical",
        "rendered"
      ],
      "additionalProperties": false,
      "properties": {
        "numerical": {
          "type": "object",
          "additionalProperties": {
            "const": true
          },
          "description": "Exact non-holdout membership of the admitted numerical scope; detailed survival/veto proof frozen separately."
        },
        "rendered": {
          "type": "object",
          "additionalProperties": {
            "const": true
          },
          "description": "Exact non-holdout membership of the admitted rendered scope; detailed survival/veto proof frozen separately."
        }
      }
    },
    "configuration": {
      "type": "object",
      "required": [
        "fixtures",
        "candidates",
        "runtimeArtifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "fixtures": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "candidates": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "profiles"
            ],
            "additionalProperties": false,
            "properties": {
              "profiles": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "material",
                    "receded"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "material": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                    },
                    "receded": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                    }
                  }
                }
              }
            }
          }
        },
        "runtimeArtifacts": {
          "$ref": "#/$defs/runtimeArtifacts",
          "minProperties": 1,
          "required": [
            "packages/policy/dist/index.js"
          ]
        }
      }
    },
    "cellScore": {
      "type": "object",
      "required": [
        "status",
        "passes"
      ],
      "properties": {
        "status": {
          "enum": [
            "measured",
            "censored-bound-satisfied",
            "UNMEASURED"
          ]
        },
        "passes": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "const": "censored"
        },
        "constraintsPass": {
          "type": "boolean"
        }
      },
      "description": "X31 v2.2: every measured cell must pass; censored cells must be UNMEASURED, reason=censored, passes=null, constraintsPass=true. They count toward neither passes nor measured coverage. Extra per-bin/channel/repeat details retained."
    },
    "runtimeArtifacts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^packages/policy/dist/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:js|mjs|cjs)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^packages/calibration/results/(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "description": "Actual repository-relative policy/dist JS module paths mapped to committed evidence snapshot paths. Must exactly enumerate all built JS modules, including index.js, in production. Snapshot hashes appear in files; actual module bytes are compared at freeze and before/after callbacks."
    }
  }
}
