--- /dev/null
+++ b/e2e/bench/w42-profile.spec.ts
@@ -0,0 +1,36 @@
+// TEMPORARY perf-wave profiling spec (not committed).
+import { writeFileSync } from "node:fs";
+import { test } from "@playwright/test";
+import { openHarness, requireHardwareAdapter } from "../support";
+const LAW = { bodyLawStrength: 1, bodyLawWidthUnit: 1, bodyLawEncodedAveraging: 1 };
+const M = { widthCss: 390, heightCss: 844, devicePixelRatio: 3 };
+const D = { widthCss: 1440, heightCss: 900, devicePixelRatio: 2 };
+const rows = JSON.parse(process.env["W42_PROFILE_ROWS"] ?? "null") ?? [
+  { label: "m base", ...M },
+  { label: "m law", ...M, materialProfile: LAW },
+  { label: "m law -narrow", ...M, materialProfile: LAW, lawKnobs: { skip: ["narrow"] } },
+  { label: "m law -wide", ...M, materialProfile: LAW, lawKnobs: { skip: ["wide"] } },
+  { label: "m law -floor", ...M, materialProfile: LAW, lawKnobs: { skip: ["floor"] } },
+  { label: "m law -composite", ...M, materialProfile: LAW, lawKnobs: { skip: ["composite"] } },
+  { label: "m law -capture", ...M, materialProfile: LAW, lawKnobs: { skip: ["capture"] } },
+  { label: "m law -q1", ...M, materialProfile: LAW, lawKnobs: { skip: ["q1"] } },
+  { label: "m law -q2", ...M, materialProfile: LAW, lawKnobs: { skip: ["q2"] } },
+  { label: "m law -q4", ...M, materialProfile: LAW, lawKnobs: { skip: ["q4"] } },
+  { label: "m law f16", ...M, materialProfile: LAW, lawKnobs: { format: "rgba16float" } },
+  { label: "m law -all", ...M, materialProfile: LAW, lawKnobs: { skip: ["narrow", "wide", "floor", "composite", "capture"] } },
+  { label: "m law-receded", ...M, materialProfile: { ...LAW, bodyLawPose: 1 } },
+  { label: "d law", ...D, materialProfile: LAW },
+  { label: "d law f16", ...D, materialProfile: LAW, lawKnobs: { format: "rgba16float" } },
+  { label: "m base control", ...M },
+];
+test("@w42-profile stage ablations", async ({ page }) => {
+  test.setTimeout(900_000);
+  requireHardwareAdapter(await openHarness(page));
+  const out = [];
+  for (let run = 0; run < Number(process.env["W42_PROFILE_RUNS"] ?? 3); run += 1) {
+    const m = await page.evaluate((configs) => window.vitrea.bench({ configs, rounds: 60, warmup: 20 }), rows);
+    out.push(m.results.map((r: any) => ({ label: r.label, wall: r.wallMsPerFrame, cpu: r.cpuMsPerFrame,
+      gpu: r.gpuMsPerFrame, passMs: r.passMs, warm: r.warmWallMs })));
+  }
+  writeFileSync(process.env["W42_PROFILE_OUT"] ?? "/tmp/w42-perf/profile.json", JSON.stringify(out, null, 1));
+});
