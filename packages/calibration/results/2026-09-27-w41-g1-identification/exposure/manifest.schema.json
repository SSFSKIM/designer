{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W41 G1 committed endpoint-scoped renderer exposure manifest",
  "description": "Generated by runner.freeze, committed before runner.run_production. The files map holds SHA-256 hashes over verified committed payload bytes, never hash-only promises. See README for scorer and pixel payload contracts. Production membership is declared glass intersected with the fixed committed archive inventory. runtimeArtifacts separately binds executed policy build modules to committed byte snapshots. G1 additive version under Decision Log 7; G0 scope/schema/evidence remain unchanged. Claims select metadata endpoints, never cells; all admitted scores remain. Unclaimed rendered predictions equal committed shipped baseline bytes across all roles, including blind web holdout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "revision",
    "boundarySha256",
    "runnerSha256",
    "scenes",
    "split",
    "generation",
    "numericalCells",
    "renderedCells",
    "sourceFiles",
    "files",
    "candidates",
    "config",
    "scorer",
    "declaration",
    "closure",
    "instruments",
    "inventory",
    "excludedCells",
    "runtimeArtifacts",
    "claimScopes",
    "identityEquality"
  ],
  "properties": {
    "schema": {
      "const": "w41-renderer-exposure-2"
    },
    "mode": {
      "enum": [
        "production",
        "synthetic"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "boundarySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runnerSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenes": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "split": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "numericalCells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^/]+/[^/]+$"
      }
    },
    "renderedCells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^/]+/[^/]+$"
      }
    },
    "sourceFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parameters",
          "predictions",
          "rendered",
          "survival",
          "claimScope",
          "domainEvidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "parameters": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "predictions": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "rendered": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "survival": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "claimScope": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "identityBaseline": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "domainEvidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        },
        "description": "claimScope names committed endpoint JSON. identityBaseline is mandatory whenever any rendered endpoint is unclaimed; exact unclaimed membership across every role."
      }
    },
    "config": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "scorer": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "declaration": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "closure": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "instruments": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "inventory": {
      "type": [
        "string",
        "null"
      ],
      "description": "Fixed committed inventory metadata path in production; null for a synthetic subset."
    },
    "excludedCells": {
      "type": "object",
      "required": [
        "numerical",
        "rendered"
      ],
      "additionalProperties": false,
      "properties": {
        "numerical": {
          "type": "object",
          "additionalProperties": {
            "const": "not admitted by fixed archive inventory"
          }
        },
        "rendered": {
          "type": "object",
          "additionalProperties": {
            "const": "not admitted by fixed archive inventory"
          }
        }
      },
      "description": "Declared scope minus admitted scope, with a reason for each excluded cell. Does not change the split. Empty maps in synthetic mode."
    },
    "runtimeArtifacts": {
      "$ref": "#/$defs/runtimeArtifacts"
    },
    "claimScopes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/claimScope"
      }
    },
    "identityEquality": {
      "type": "object",
      "minProperties": 1,
      "description": "Candidate -> exact unclaimed rendered cells, all roles -> verified PNG and projection hashes, source paths and role. Empty per-candidate map for an all-endpoint claim. Byte equality, not a caller boolean.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "baseline",
            "candidate",
            "baselinePngSha256",
            "candidatePngSha256",
            "baselineProjectionSha256",
            "candidateProjectionSha256"
          ],
          "properties": {
            "role": {
              "enum": [
                "calibration",
                "validation",
                "holdout"
              ]
            },
            "baseline": {
              "type": "object",
              "required": [
                "png",
                "projection"
              ],
              "additionalProperties": false,
              "properties": {
                "png": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                "projection": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                }
              }
            },
            "candidate": {
              "type": "object",
              "required": [
                "png",
                "projection"
              ],
              "additionalProperties": false,
              "properties": {
                "png": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                "projection": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                }
              }
            },
            "baselinePngSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "candidatePngSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "baselineProjectionSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "candidateProjectionSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "production"
          }
        }
      },
      "then": {
        "properties": {
          "generation": {
            "const": [
              "58329732f947d42cd5e1518962016191faaa79d89b7089c6dadf5724dde35f61"
            ]
          },
          "inventory": {
            "const": "packages/calibration/results/2026-09-26-w39-g1-colour-edge-sitting/archive/inventory.json"
          },
          "runtimeArtifacts": {
            "minProperties": 1,
            "required": [
              "packages/policy/dist/index.js"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "inventory": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parameters",
        "predictions",
        "rendered",
        "survival",
        "claimScope",
        "domainEvidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "parameters": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "predictions": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "rendered": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "survival": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "claimScope": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "identityBaseline": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "domainEvidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      },
      "description": "claimScope names committed endpoint JSON. identityBaseline is mandatory whenever any rendered endpoint is unclaimed; exact unclaimed membership across every role."
    },
    "numericalPredictions": {
      "type": "object",
      "required": [
        "cells"
      ],
      "additionalProperties": false,
      "properties": {
        "cells": {
          "type": "object",
          "minProperties": 1,
          "description": "Exact declared AND archive-admitted glass membership of numericalCells; finite, nonempty forward-output JSON per cell. No native observations."
        }
      }
    },
    "renderedPredictions": {
      "type": "object",
      "required": [
        "cells"
      ],
      "additionalProperties": false,
      "properties": {
        "cells": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "png",
              "projection"
            ],
            "additionalProperties": false,
            "properties": {
              "png": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "projection": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              }
            }
          }
        }
      }
    },
    "survival": {
      "type": "object",
      "required": [
        "numerical",
        "rendered",
        "veto"
      ],
      "additionalProperties": false,
      "properties": {
        "numerical": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "const": true
              },
              {
                "$ref": "#/$defs/unclaimedAssessment"
              }
            ]
          },
          "description": "Exact admitted non-holdout membership; true on claimed endpoints; not-claimed assessment retaining score elsewhere."
        },
        "rendered": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "const": true
              },
              {
                "$ref": "#/$defs/unclaimedAssessment"
              }
            ]
          },
          "description": "Exact admitted non-holdout membership. True for uniform claimed-endpoint deep closure; structured claimed-endpoint deep observations are not claimed (structured backdrop), with the actual score retained. Unclaimed endpoints remain not claimed (identity). The separate veto is required everywhere."
        },
        "veto": {
          "type": "object",
          "additionalProperties": {
            "const": true
          },
          "description": "Exact full admitted rendered calibration/validation membership. No claim-scope exemption."
        }
      }
    },
    "configuration": {
      "type": "object",
      "required": [
        "fixtures",
        "candidates",
        "runtimeArtifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "fixtures": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "candidates": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "profiles"
            ],
            "additionalProperties": false,
            "properties": {
              "profiles": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "material",
                    "receded"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "material": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                    },
                    "receded": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                    }
                  }
                }
              }
            }
          }
        },
        "runtimeArtifacts": {
          "$ref": "#/$defs/runtimeArtifacts",
          "minProperties": 1,
          "required": [
            "packages/policy/dist/index.js"
          ]
        }
      }
    },
    "cellScore": {
      "type": "object",
      "required": [
        "status",
        "passes"
      ],
      "properties": {
        "status": {
          "enum": [
            "measured",
            "censored-bound-satisfied",
            "UNMEASURED"
          ]
        },
        "passes": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "const": "censored"
        },
        "constraintsPass": {
          "type": "boolean"
        },
        "vetoPass": {
          "type": "boolean",
          "description": "Required true by runner on every rendered heldout row, claimed or not."
        },
        "diagnostic": {
          "type": "string",
          "description": "S0 is required for structured-backdrop numerical readings inside an otherwise claimed endpoint."
        }
      },
      "description": "Raw score for every admitted cell. Uniform claimed-endpoint numerical and rendered-deep measured rows must pass; censored rows retain X31 constraintsPass=true and no coverage. Unclaimed or structured rows may miss, but retain valid observations. Structured numerical rows require S0; rendered observations are not S0. Every rendered row requires vetoPass=true independently of deep closure scope."
    },
    "runtimeArtifacts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^packages/policy/dist/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:js|mjs|cjs)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^packages/calibration/results/(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "description": "Actual repository-relative policy/dist JS module paths mapped to committed evidence snapshot paths. Must exactly enumerate all built JS modules, including index.js, in production. Snapshot hashes appear in files; actual module bytes are compared at freeze and before/after callbacks."
    },
    "claimScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoints",
        "domain",
        "numericalDomain",
        "renderedDeepDomain"
      ],
      "properties": {
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "colorScheme",
              "activation"
            ],
            "properties": {
              "colorScheme": {
                "enum": [
                  "light",
                  "dark"
                ]
              },
              "activation": {
                "enum": [
                  "active",
                  "inactive"
                ]
              }
            }
          }
        },
        "domain": {
          "const": {
            "policy": "nominal",
            "variant": "regular",
            "samplingBackend": "gpu-texture",
            "presence": {
              "identified": 1,
              "intermediate": "unmeasured-linear-interpolation",
              "zero": "exact-skip"
            }
          }
        },
        "numericalDomain": {
          "const": "uniform-backdrop",
          "description": "Numerical E3 claim requires public background.kind=solid. Structured backdrop numeric scores remain S0 diagnostics, not admission or failure. Rendered/shader domain remains actual sampled textures, including gradients."
        },
        "renderedDeepDomain": {
          "const": "uniform-backdrop",
          "description": "Absolute-deep rendered closure is claimed only on uniform backgrounds at claimed endpoints. Structured rendered deep observations remain diagnostics, never S0 numerical predictions. Full per-bin/channel/repeat veto, all rendered membership, and sampled-texture shader execution remain binding."
        }
      }
    },
    "identityBaseline": {
      "$ref": "#/$defs/renderedPredictions",
      "description": "Committed shipped baseline payloads for exact unclaimed rendered membership, including blind heldout web renders. All PNG/projection payload paths are committed and hashed."
    },
    "unclaimedAssessment": {
      "type": "object",
      "required": [
        "status",
        "passes",
        "score"
      ],
      "properties": {
        "status": {
          "enum": [
            "not claimed (identity)",
            "not claimed (structured backdrop)"
          ]
        },
        "passes": {
          "type": "null"
        },
        "score": {
          "$ref": "#/$defs/cellScore"
        }
      },
      "description": "Fidelity observation retained without a closure claim: a measured miss or failed censored constraint is allowed here, never counted as a pass."
    },
    "domainEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation",
        "cells"
      ],
      "properties": {
        "attestation": {
          "type": "string"
        },
        "cells": {
          "type": "object",
          "description": "Exact full admitted rendered membership. Each value preserves complete decoded descriptor and report JSON from its web capture.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "descriptor",
              "report"
            ],
            "additionalProperties": false,
            "properties": {
              "descriptor": {
                "type": "object",
                "description": "Complete decoded cell__webgpu.json. Scene, dimensions, actual renderer/backend, deterministic capture and sRGB Chromium facts must match the frozen Wave."
              },
              "report": {
                "type": "object",
                "description": "Complete decoded report__webgpu.json wrapper, not a flattened page. Driver scheme, material/receded short file hashes and patches bind to committed configuration documents. page holds actual scale/scheme/policy/sampling and candidate pose observations: injected receded scenes keep root active and merge the receded patch. No runtime variant or presence field is invented."
              }
            }
          }
        }
      }
    },
    "domainAttestation": {
      "type": "object",
      "required": [
        "basis",
        "variant",
        "presence",
        "effectivePresenceBasis",
        "limitations",
        "sourceChain"
      ],
      "properties": {
        "basis": {
          "const": "source-derived"
        },
        "variant": {
          "const": "regular"
        },
        "presence": {
          "const": 1
        },
        "effectivePresenceBasis": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "sourceChain": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "claim"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "claim": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
