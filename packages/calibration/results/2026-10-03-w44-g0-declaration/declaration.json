        "statistic": "the driver's interiorStdDev: luminance SD in linear light over the NATIVE silhouette bounded to the declared region (rim and lens band included), material.interiorStdDev{Native,Web}.value, web against native",
        "oneCode": "the linear step of one encoded sRGB code at the cell's native interior mean: the sRGB decode's derivative there / 255",
        "strata": {
          "F": [
            "checkerboard-4",
            "checkerboard-8",
            "hc-text-7"
          ],
          "C": [
            "checkerboard",
            "checkerboard-lc16",
            "checkerboard-32",
            "checkerboard-64",
            "hc-text",
            "hc-text-28",
            "impulse"
          ],
          "P": [
            "photo"
          ]
        },
        "populationPerLightProfile": {
          "cells": 116,
          "F": 19,
          "C": 69,
          "P": 28,
          "gate": 94,
          "holdout": 16,
          "referee": 6
        },
        "partitions": "holdout (canonical split), referee (referees.json), gate (the rest); a stage before the exposure carries the gate partition only",
        "outputs": {
          "bound": "B = max(1 code, 2 bar); e(x) = |x - n|; g = e(k) - e(c); delta = |k - c|; n native, c the c05 reading, k the candidate's",
          "fidelity": "within if e(k) <= B, or if n >= 1 code and |k / n - 1| <= 0.10; else miss, reported with k - n",
          "change": "by precedence: unchanged if delta <= bar; else overshoot if (k - n)(c - n) < 0 and the cell is a miss; else toward if g < 0, or |g| <= 1e-12 with a sign change; else away",
          "aggregates": "per stratum x scale x tier x pose, the median of |log((k + eps) / (n + eps))|, eps = 1 code, and the count of each state; over the gate partition, and over every partition read"
        },
        "changePrecedence": [
          "unchanged",
          "overshoot",
          "toward",
          "away"
        ],
        "ratioClause": 0.1,
        "equalTolerance": 1e-12,
        "gated": {
          "profiles": [
            "apple-macos-27.0-1x-light-standard-glass0.25",
            "apple-macos-27.0-2x-light-standard-glass0.25"
          ],
          "tier": "webgpu",
          "read": "the same profiles' CSS tier (a tier residual), the dark 0.25 profiles, the 0.5 profiles"
        },
        "landingScope": "WebGPU, 2x light, both poses, F u C u P, gate partition; a member with no reading makes the verdict UNMEASURED",
