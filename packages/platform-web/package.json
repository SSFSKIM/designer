{
  "name": "@vitrea/platform-web",
  "version": "0.0.0",
  "private": true,
  "description": "Internal: DOM host registration, plane management, backdrop proxies, CSS-tier renderer, WebGPU lifecycle. Bundled into @vitrea/react at publish.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:gpu": "playwright test --project=chromium-gpu"
  },
  "dependencies": {
    "@vitrea/core": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@vitrea/geometry": "workspace:*",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "pngjs": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
