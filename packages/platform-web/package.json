{
  "name": "@vitreajs/vitrea-web",
  "version": "0.4.0",
  "description": "Framework-agnostic browser host for vitrea: mount a glass root from any framework, or none. DOM host registration, plane management, backdrop proxies, CSS-tier renderer, WebGPU lifecycle.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/SSFSKIM/designer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SSFSKIM/designer.git",
    "directory": "packages/platform-web"
  },
  "keywords": ["liquid-glass", "webgpu", "material", "glass", "ui", "backdrop-filter", "vanilla-js"],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "LICENSE", "NOTICE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . && tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:gpu": "playwright test --project=chromium-gpu"
  },
  "dependencies": {
    "@vitreajs/vitrea": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@vitrea/geometry": "workspace:*",
    "@vitrea/policy": "workspace:*",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "pngjs": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
