{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Node types are here for the WGSL range scan under `test/` (W31 G2; claims
    // §5.163), which reads every file in `src/wgsl/` off disk. `tsconfig.build.json`
    // takes them straight back out, so the SHIPPED compile still sees no Node
    // globals and this cannot become a way for one to reach `src/`.
    "types": ["node"]
  },
  "include": ["src", "test", "types"]
}
