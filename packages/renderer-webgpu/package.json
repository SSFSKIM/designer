{
  "name": "@vitrea/renderer-webgpu",
  "version": "0.0.0",
  "private": true,
  "description": "Internal: WebGPU resource graph, WGSL passes, texture pool. Loaded by @vitrea/core behind a dynamic import (X7).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:golden": "playwright test --grep @golden",
    "test:gpu": "playwright test --grep @gpu",
    "test:bench": "playwright test --grep @bench"
  },
  "dependencies": {
    "@vitrea/geometry": "workspace:*",
    "@vitrea/motion": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "eslint": "catalog:",
    "pngjs": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
